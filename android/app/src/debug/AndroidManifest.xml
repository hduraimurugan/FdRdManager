<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-build-only overlay, merged only into debug/dev builds — never into
         release. The app has no network dependency at runtime (verified: no fetch/XHR
         calls to a remote URL anywhere in src/); this permission exists solely so a
         debug build can reach the Metro dev server over http://localhost:8081 to load
         its JS bundle. See android/app/src/main/AndroidManifest.xml for the production
         permission set, which deliberately omits INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
