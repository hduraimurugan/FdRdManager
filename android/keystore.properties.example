# Copy this file to keystore.properties (same directory) and fill in your real values.
# keystore.properties is gitignored — never commit your real passwords or keystore path.
# See the "Release signing" section of the README for how to generate the keystore itself.

storeFile=/absolute/path/to/your-upload-key.keystore
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
